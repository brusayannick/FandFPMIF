# Mate – on-VM reverse proxy (production).
#
# The uni edge proxy forwards pm-mate.uni-muenster.de:80/443 to this VM's :443
# as a single HTTPS pipe. This Caddy instance terminates that TLS with the
# provided Let's Encrypt cert and fans the one origin out to the three
# app containers by path. See DEPLOY.md for the full picture.

{
	# We ship our own cert and sit behind the uni proxy – no ACME.
	auto_https off
}

# Bind by port (not hostname): the cert's name (pm-mate-vm) differs from the
# public name (pm-mate), and we're behind another proxy, so match any SNI/Host.
:443 {
	tls /etc/letsencrypt/live/pm-mate-vm.uni-muenster.de/fullchain.pem /etc/letsencrypt/live/pm-mate-vm.uni-muenster.de/privkey.pem

	# Compress text-ish responses. The content-type allowlist deliberately
	# omits text/event-stream: compressing SSE would buffer the live job /
	# event streams. API JSON usually arrives pre-gzipped (GZipMiddleware);
	# Caddy passes already-encoded responses through untouched.
	encode zstd gzip {
		# One header line per type: Caddy ORs multiple values of the same
		# response-header field (v2.11 dropped the many-values-on-one-line form).
		match {
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type image/svg+xml*
			header Content-Type font/*
		}
	}

	# Security headers applied to every upstream. HSTS deliberately omits
	# includeSubDomains/preload: this is a shared uni domain, so we assert it
	# only for this exact host. nosniff + Referrer-Policy are always safe.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# FastAPI backend – REST under /api/v1, plus WebSocket (live jobs/events)
	# and SSE (Mate AI streaming). Caddy proxies both transparently.
	@api path /api/v1/*
	reverse_proxy @api api:8000

	# Unauthenticated liveness probe (root-level /health on the API).
	@health path /health
	reverse_proxy @health api:8000

	# Keycloak, served under the /auth relative path (KC_HTTP_RELATIVE_PATH).
	@kc path /auth/*
	reverse_proxy @kc keycloak:8080

	# Force revalidation of the Next.js HTML/RSC documents and the Auth.js
	# session route (/api/auth/*) so a fresh visit never renders a stale app
	# shell carrying an expired token – the "first load 401s, hard-refresh
	# fixes it" symptom. Scoped to EXCLUDE the api/health/keycloak upstreams
	# (incl. SSE under /api/v1/*) and the hashed, immutable build assets under
	# /_next/static + /_next/image, which must stay cacheable.
	@webDoc {
		not path /api/v1/* /health /auth/* /_next/static/* /_next/image*
	}
	header @webDoc Cache-Control "no-store"

	# Frame protection + CSP for the web app only (NOT /api, /health, or the
	# Keycloak pages under /auth, which set their own headers). CSP ships in
	# Report-Only first: it never blocks, it only surfaces violations in the
	# browser console so the policy can be tightened before it is enforced.
	# To enforce, rename the header to Content-Security-Policy and drop any
	# 'unsafe-*' the app no longer needs.
	@webApp not path /api/v1/* /health /auth/*
	header @webApp {
		X-Frame-Options "SAMEORIGIN"
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
	}

	# Everything else – the Next.js app, its static assets, and Auth.js
	# routes at /api/auth/*.
	reverse_proxy web:3000
}
