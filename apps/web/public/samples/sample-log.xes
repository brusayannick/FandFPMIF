<?xml version="1.0" encoding="UTF-8"?>
<!--
  Bundled sample event log for the "Try a sample log" one-click import.
  A small, synthetic order-handling process (8 cases, 7 activities) with a
  happy path, a cancellation path, and a back-order rework loop so process
  discovery has something interesting to show. Same XES 2.0 schema as the
  API test fixture (concept/time/org extensions), kept tiny on purpose.
-->
<log xes.version="2.0" xmlns="http://www.xes-standard.org/">
  <extension name="Concept" prefix="concept" uri="http://www.xes-standard.org/concept.xesext"/>
  <extension name="Time" prefix="time" uri="http://www.xes-standard.org/time.xesext"/>
  <extension name="Organizational" prefix="org" uri="http://www.xes-standard.org/org.xesext"/>
  <trace>
    <string key="concept:name" value="order-1001"/>
    <event>
      <string key="concept:name" value="register order"/>
      <date key="time:timestamp" value="2026-03-02T08:05:00+00:00"/>
      <string key="org:resource" value="alice"/>
    </event>
    <event>
      <string key="concept:name" value="check stock"/>
      <date key="time:timestamp" value="2026-03-02T09:10:00+00:00"/>
      <string key="org:resource" value="bob"/>
    </event>
    <event>
      <string key="concept:name" value="pick items"/>
      <date key="time:timestamp" value="2026-03-02T10:30:00+00:00"/>
      <string key="org:resource" value="dan"/>
    </event>
    <event>
      <string key="concept:name" value="ship"/>
      <date key="time:timestamp" value="2026-03-02T13:45:00+00:00"/>
      <string key="org:resource" value="erin"/>
    </event>
    <event>
      <string key="concept:name" value="invoice"/>
      <date key="time:timestamp" value="2026-03-03T09:00:00+00:00"/>
      <string key="org:resource" value="frank"/>
    </event>
